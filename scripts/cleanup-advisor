#!/usr/bin/env bash
# cleanup-advisor - Smart system resource cleanup advisor
#
# Shows which apps are using the most RAM/CPU with actionable kill commands
# Useful before: benchmarking, compiling, video editing, or any heavy task
#
# Usage:
#   cleanup-advisor              # Show all recommendations
#   cleanup-advisor --ram        # RAM hogs only
#   cleanup-advisor --cpu        # CPU hogs only

set -euo pipefail

# ── System Processes (Don't Kill) ──────────────────────────────────────────────

is_system_process() {
  local proc="$1"

  # System processes that should NOT be killed
  local system_procs=(
    "kernel" "launchd" "systemd" "WindowServer" "loginwindow"
    "Finder" "Dock" "SystemUIServer" "coreaudiod" "corestoraged"
    "cloudd" "bird" "cfprefsd" "diskarbitrationd"
  )

  for sys_proc in "${system_procs[@]}"; do
    if [[ "$proc" == *"$sys_proc"* ]]; then
      return 0  # Is system process
    fi
  done

  return 1  # Not system process
}

# ── Aggregated App RAM Usage ───────────────────────────────────────────────────

show_app_ram_totals() {
  echo "# Application RAM Totals (multiple processes grouped):"
  echo "#"

  # Group by app name and sum RAM
  ps aux | awk '{cmd=$11; gsub(/.*\//, "", cmd); gsub(/ Helper.*/, "", cmd); ram=int($6/1024); print cmd"|"ram}' | \
  awk -F'|' '
    # Map helpers to parent apps
    {
      app = $1
      if (app ~ /^[Cc]ode/) app = "Visual Studio Code"
      if (app ~ /^[Cc]hrome/) app = "Google Chrome"
      if (app ~ /^[Bb]rave/) app = "Brave Browser"
      if (app ~ /^[Ss]lack/) app = "Slack"
      if (app ~ /^[Dd]iscord/) app = "Discord"
      if (app ~ /^[Tt]eams/) app = "Microsoft Teams"

      ram[app] += $2
      count[app]++
    }
    END {
      for (app in ram) {
        if (ram[app] > 200) {  # Only show apps using >200MB total
          printf "%s|%d|%d\n", app, count[app], ram[app]
        }
      }
    }
  ' | sort -t'|' -k3 -rn | head -10 | \
  while IFS='|' read -r app proc_count total_mb; do
    local gb=$(echo "scale=1; $total_mb / 1024" | bc)
    printf "# - %-30s %2d procs  %5dMB  (%.1fGB)\n" "$app" "$proc_count" "$total_mb" "$gb"

    # Suggest kill command
    case "$app" in
      "Visual Studio Code")
        echo "#   Kill: code --stop  or  pkill -x 'Code'"
        ;;
      "Google Chrome"|"Brave Browser"|"Slack"|"Discord"|"Microsoft Teams")
        echo "#   Kill: pkill -x '$app'"
        ;;
    esac
  done

  echo "#"
  echo "# ⚠️  VSCode example: 8x 'Code Helper' processes = 5GB total!"
  echo "#"
}

# ── Individual Process Lists ───────────────────────────────────────────────────

suggest_ram_cleanup() {
  echo "# Individual RAM Consumers (>100MB):"
  echo "#"

  local total_freeable=0
  local count=0

  # Get top processes by RAM, excluding system ones
  if [[ "$(uname -s)" == "Darwin" ]]; then
    # macOS
    ps aux | awk 'NR>1 && $6 > 102400 {printf "%s|%s|%s|%s\n", $2, $11, int($6/1024), $3}' | \
    while IFS='|' read -r pid cmd ram_mb cpu_pct; do
      # Skip system processes
      if is_system_process "$cmd"; then
        continue
      fi

      # Get just the command name (not full path)
      local cmd_name=$(basename "$cmd")

      printf "# - %-30s PID %-7s RAM %5dMB  CPU %5.1f%%\n" \
        "$cmd_name" "$pid" "$ram_mb" "$cpu_pct"
      printf "#   Kill: kill %s\n" "$pid"

      total_freeable=$((total_freeable + ram_mb))
      ((count++)) || true

      [[ $count -ge 5 ]] && break
    done | sort -t ' ' -k7 -rn  # Sort by RAM descending
  else
    # Linux
    ps aux --sort=-rss | awk 'NR>1 && $6 > 102400 {printf "%s|%s|%s|%s\n", $2, $11, int($6/1024), $3}' | \
    head -10 | \
    while IFS='|' read -r pid cmd ram_mb cpu_pct; do
      if is_system_process "$cmd"; then
        continue
      fi

      local cmd_name=$(basename "$cmd")
      printf "# - %-30s PID %-7s RAM %5dMB  CPU %5.1f%%\n" \
        "$cmd_name" "$pid" "$ram_mb" "$cpu_pct"
      printf "#   Kill: kill %s\n" "$pid"

      total_freeable=$((total_freeable + ram_mb))
      ((count++)) || true

      [[ $count -ge 5 ]] && break
    done
  fi

  if [[ $count -eq 0 ]]; then
    echo "# - (no heavy individual processes found)"
  fi

  echo "#"
}

suggest_cpu_cleanup() {
  echo "# Top CPU Consumers (>10% usage):"
  echo "#"

  local count=0

  if [[ "$(uname -s)" == "Darwin" ]]; then
    # macOS
    ps aux | awk 'NR>1 && $3 > 10 {printf "%s|%s|%s|%s\n", $2, $11, $3, int($6/1024)}' | \
    while IFS='|' read -r pid cmd cpu_pct ram_mb; do
      if is_system_process "$cmd"; then
        continue
      fi

      local cmd_name=$(basename "$cmd")
      printf "# - %-30s PID %-7s CPU %5.1f%%  RAM %5dMB\n" \
        "$cmd_name" "$pid" "$cpu_pct" "$ram_mb"
      printf "#   Kill: kill %s\n" "$pid"

      ((count++)) || true
      [[ $count -ge 5 ]] && break
    done | sort -t ' ' -k7 -rn
  else
    # Linux
    ps aux --sort=-pcpu | awk 'NR>1 && $3 > 10 {printf "%s|%s|%s|%s\n", $2, $11, $3, int($6/1024)}' | \
    head -10 | \
    while IFS='|' read -r pid cmd cpu_pct ram_mb; do
      if is_system_process "$cmd"; then
        continue
      fi

      local cmd_name=$(basename "$cmd")
      printf "# - %-30s PID %-7s CPU %5.1f%%  RAM %5dMB\n" \
        "$cmd_name" "$pid" "$cpu_pct" "$ram_mb"
      printf "#   Kill: kill %s\n" "$pid"

      ((count++)) || true
      [[ $count -ge 5 ]] && break
    done
  fi

  if [[ $count -eq 0 ]]; then
    echo "# - (no heavy CPU users found)"
  fi

  echo "#"
}

suggest_quick_cleanup() {
  echo "# Quick Cleanup Commands:"
  echo "#"
  echo "# Close common heavy apps:"
  echo "#   pkill -x 'Google Chrome' 'Brave Browser' 'Firefox' 'Slack' 'Discord'"
  echo "#   pkill -x 'Microsoft Teams' 'Zoom' 'Docker'"
  echo "#"
  echo "# Stop Electron apps:"
  echo "#   pkill Electron"
  echo "#"
}

# ── CLI Arguments ──────────────────────────────────────────────────────────────

SHOW_RAM=true
SHOW_CPU=true

while [[ $# -gt 0 ]]; do
  case "$1" in
    --ram)
      SHOW_CPU=false
      shift
      ;;
    --cpu)
      SHOW_RAM=false
      shift
      ;;
    --help|-h)
      echo "cleanup-advisor - Smart system resource cleanup"
      echo ""
      echo "Usage:"
      echo "  cleanup-advisor           # Show all recommendations"
      echo "  cleanup-advisor --ram     # RAM hogs only"
      echo "  cleanup-advisor --cpu     # CPU hogs only"
      echo "  cleanup-advisor --help    # This message"
      echo ""
      echo "Examples:"
      echo "  cleanup-advisor           # See what's using resources"
      echo "  cleanup-advisor --ram     # Before running a memory-intensive task"
      exit 0
      ;;
    *)
      echo "Unknown option: $1"
      echo "Run with --help for usage"
      exit 1
      ;;
  esac
done

# ── Main ───────────────────────────────────────────────────────────────────────

main() {
  echo ""
  echo "╔══════════════════════════════════════════════════╗"
  echo "║   Cleanup Advisor                                ║"
  echo "╚══════════════════════════════════════════════════╝"
  echo ""

  # Always show aggregated view first (most useful)
  show_app_ram_totals

  if $SHOW_RAM; then
    suggest_ram_cleanup
  fi

  if $SHOW_CPU; then
    suggest_cpu_cleanup
  fi

  if $SHOW_RAM && $SHOW_CPU; then
    suggest_quick_cleanup
  fi

  echo "# ⚠️  WARNING: Only kill processes you recognize!"
  echo "# Check what each process does before killing it."
  echo ""
  echo "# Install system-wide: ln -s \$(pwd)/cleanup-advisor ~/.local/bin/"
  echo ""
}

# Run if executed directly
if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
  main "$@"
fi
